{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/rpc.js": {
      "maxDuration": 300,
      "includeFiles": "lib/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "regions": [
    "icn1"
  ]
}